# Lumiveil environment — copy to .env and fill in. NEVER commit .env.
PORT=3000
DATA_DIR=./data

# Persistence: set both to use a Turso cloud database (accounts + stories
# survive redeploys). Leave empty for a local SQLite file (ephemeral).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI characters. Leave empty to run without AI — chats open with each
# character's greeting and the app shows a clear "AI not configured" state
# instead of faking replies. Messages are still saved to the story memory.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
